# Copy this file to .env and fill in real values. NEVER commit .env.
# Get these from your browser cookies on leetcode.com (Application > Cookies).
LEETCODE_SESSION=your_leetcode_session_cookie_here
LEETCODE_CSRF=your_csrf_token_here

# Local SQLite cache location.
DATABASE_URL=file:./data/leetmind.db

# LeetCode username whose profile this agent serves.
LEETCODE_USERNAME=Kalpit00

# LLM provider for the agent's reasoning + tool calling.
MODEL_PROVIDER=openai
MODEL_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
